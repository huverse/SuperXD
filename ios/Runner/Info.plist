<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleName</key>
	<string>SuperXD</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- 住理生活的支付宝付款：付完从支付宝回到本应用的 scheme（tobias 按 CFBundleURLName 为 alipay 的这一项取；用 bundle id，开发包与 Alpha 包各回各的），与能问支付宝装没装。 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>alipay</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>alipays</string>
		<string>alipay</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.superxd.superxd.autoSync</string>
	</array>
	<!-- [人工决策-2026-11-22 17:15:38] ATS 只开本机网络（用户说「按照最佳实践优化」）：电影院的系统播放器 AVPlayer 经本机代理 http://127.0.0.1 取播放清单，
	     iOS 17 起 ATS 默认拦直连 IP 地址（iOS 16 默认放行），只加 NSAllowsLocalNetworking（本机、.local 与直连 IP），公网照旧受 ATS 保护；
	     不开 NSAllowsArbitraryLoads 与 NSAllowsArbitraryLoadsForMedia（明文的分片仍会被拦，打不开时这一页退回 mpv）。Dart 自己的请求不受 ATS 管。test/legal_page_test.dart 守护。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>面对面私信经蓝牙发现附近打开面对面的好友并互发卡片；住理生活经蓝牙连接洗浴设备开水关水。不用于定位。</string>
	<key>NSCameraUsageDescription</key>
	<string>扫好友二维码、签到二维码与驿站码，以及拍照签到时使用相机。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>学习通位置签到、胖乖生活找附近门店和下单时读取当前位置，只在用到时使用。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>把下载的视频图片、开屏画作、驿站码与红包二维码存进相册。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>读取你选中的照片，用作壁纸、签到照片或识别其中的二维码。</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- [人工决策-2026-11-20 16:53:46] 平时只竖屏（同安卓清单 MainActivity 那条），例外是电影院播放器的全屏转真横屏（用户选定「全屏时真横屏」）：
	     这里列出两种横向才转得过去，平时由 lib/main.dart 启动时 setPreferredOrientations 锁回竖屏（test/shell_layout_test.dart 守护）。 -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
