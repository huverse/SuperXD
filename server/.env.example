# 复制为 .env 后修改密码；.env 不入库。
RELAY_PORT=8080
# 对外端口（docker compose 映射到宿主机）
RELAY_PUBLIC_PORT=8080
# 前面有 Nginx 等反向代理时设为 1
RELAY_TRUST_PROXY=0
RELAY_SWAGGER=false
# 构建镜像时的 npm 源；国内服务器用 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=superxd_relay
MYSQL_USER=superxd
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-as-well
REDIS_DB=0
REDIS_KEY_PREFIX=sxd:
