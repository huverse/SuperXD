# 复制为 .env 后修改密码；.env 不入库。
RELAY_PORT=8080
# 对外端口（docker compose 映射到宿主机）
RELAY_PUBLIC_PORT=8080
# 前面有 Nginx 等反向代理时设为 1
# 前面没有代理填 0；有 compose 里的 Nginx（tls）终止 HTTPS 时填 uniquelocal（只信内网来的 X-Forwarded-For，见 src/config/env.ts 与 README「HTTPS」）。
RELAY_TRUST_PROXY=0
RELAY_SWAGGER=false
# 应用更新的清单与安装包目录（docker compose 部署时由 compose 固定为容器内 /srv/releases，这里只给本地开发用）
RELAY_RELEASES_DIR=./releases
# 诊断包密文的存放目录，要可写（docker compose 部署时由 compose 固定为容器内 /srv/diagnostics 的命名卷，这里只给本地开发用）
RELAY_DIAGNOSTICS_DIR=./diagnostics
# 业务时区（IANA 名，同客户端 campusTimeZone）：每周轮换的挑战按它的周一 0 点换。docker compose 部署时由 compose 固定，这里只给本地开发用
RELAY_BUSINESS_TIME_ZONE=Asia/Shanghai
# 应用账号：客户端封装密码与恢复码用的 X25519 私钥种子（32 字节 base64url，对应的公钥写死在客户端 lib/relay/account_seal.dart）。
# 可以写几把（逗号分隔、现用的在前、最多 4 把）：换钥过渡期新旧两把都认，步骤见 README「部署」应用账号一条。
# 在开发者本机生成、本机另存一份，经 ssh 写进服务器 .env，不进仓库（见 README「部署」应用账号一条）
RELAY_ACCOUNT_SEAL_KEY=change-me
# 服务器在线签名钥：给好友公钥、奖品信封与「账号已注销」签名的 Ed25519 私钥种子（32 字节 base64url，公钥写死在客户端 lib/relay/relay_client.dart 的 relayServerKeys；名字沿用最早只签好友公钥时的叫法）。生成与存放同上
RELAY_FRIEND_SIGN_KEY=change-me
# IP 属地离线库（扫码登录给批准方看请求方的属地）：镜像里已由 Dockerfile 设好，这里不用写；本地开发要看属地时指向下载的 ip2region_v4.xdb，不写就不显示属地。
# RELAY_IP_REGION_DB=./ip2region_v4.xdb
# 构建镜像时的 npm 源；国内服务器用 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
# docker compose 运行的中转镜像：docker load 流水线的镜像包后改成 superxd-relay:<提交号>，回滚改回上一个（见 README「部署」）
RELAY_IMAGE=superxd-relay:local

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=superxd_relay
MYSQL_USER=superxd
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-as-well
REDIS_DB=0
REDIS_KEY_PREFIX=sxd:
