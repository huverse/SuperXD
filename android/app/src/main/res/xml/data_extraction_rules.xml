<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="superxd_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="file" path="toolbox/" />
        <exclude domain="file" path="backgroundDownloaderTaskRecords/" />
        <exclude domain="file" path="backgroundDownloaderResumeData/" />
        <exclude domain="file" path="backgroundDownloaderDatabase/" />
        <!-- 下载的字体包（衬线等）只是可以重新下载的缓存，不随备份与换机迁移。 -->
        <exclude domain="file" path="font_packs/" />
        <exclude domain="sharedpref" path="com.superxd.superxd_preferences.xml" />
        <exclude domain="sharedpref" path="com.superxd.superxd.alpha_preferences.xml" />
        <exclude domain="sharedpref" path="superxd_course_widget.xml" />
        <exclude domain="sharedpref" path="superxd_course_live.xml" />
        <!-- 私信身份私钥只属于这台设备（Keystore 加密，换机无法解密）；私信库随身份一起排除，避免恢复出无法解密的会话。 -->
        <exclude domain="sharedpref" path="superxd_social.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_social.xml" />
        <exclude domain="database" path="social.db" />
        <!-- 11-14 起每个应用账号一份私信库，除第一个账号沿用 social.db 外都在 social 文件夹里（lib/social/social_spaces.dart）。 -->
        <exclude domain="database" path="social/" />
        <!-- 学习通密码与 Cookie 同样只属于这台设备（库 chaoxing.db 在上面排除的 toolbox 目录里）。 -->
        <exclude domain="sharedpref" path="superxd_chaoxing.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_chaoxing.xml" />
        <!-- 拼多多登录会话（身份码取件凭证）同样只属于这台设备，不随备份与换机迁移。 -->
        <exclude domain="sharedpref" path="superxd_pdd.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_pdd.xml" />
        <!-- 应用账号的设备密钥同样只属于这台设备（每个教务账号一把，与私信身份分开），不随备份与换机迁移。 -->
        <exclude domain="sharedpref" path="superxd_account.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_account.xml" />
        <!-- 本机诊断日志（应用专属外部目录的 logs，取不到时退回应用支持目录的 logs）与开发者设置 developer.json 只属于这台设备，不随备份与换机迁移。 -->
        <exclude domain="external" path="logs/" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="developer.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="superxd_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="file" path="toolbox/" />
        <exclude domain="file" path="backgroundDownloaderTaskRecords/" />
        <exclude domain="file" path="backgroundDownloaderResumeData/" />
        <exclude domain="file" path="backgroundDownloaderDatabase/" />
        <!-- 下载的字体包（衬线等）只是可以重新下载的缓存，不随备份与换机迁移。 -->
        <exclude domain="file" path="font_packs/" />
        <exclude domain="sharedpref" path="com.superxd.superxd_preferences.xml" />
        <exclude domain="sharedpref" path="com.superxd.superxd.alpha_preferences.xml" />
        <exclude domain="sharedpref" path="superxd_course_widget.xml" />
        <exclude domain="sharedpref" path="superxd_course_live.xml" />
        <!-- 私信身份私钥只属于这台设备（Keystore 加密，换机无法解密）；私信库随身份一起排除，避免恢复出无法解密的会话。 -->
        <exclude domain="sharedpref" path="superxd_social.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_social.xml" />
        <exclude domain="database" path="social.db" />
        <!-- 11-14 起每个应用账号一份私信库，除第一个账号沿用 social.db 外都在 social 文件夹里（lib/social/social_spaces.dart）。 -->
        <exclude domain="database" path="social/" />
        <!-- 学习通密码与 Cookie 同样只属于这台设备（库 chaoxing.db 在上面排除的 toolbox 目录里）。 -->
        <exclude domain="sharedpref" path="superxd_chaoxing.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_chaoxing.xml" />
        <!-- 拼多多登录会话（身份码取件凭证）同样只属于这台设备，不随备份与换机迁移。 -->
        <exclude domain="sharedpref" path="superxd_pdd.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_pdd.xml" />
        <!-- 应用账号的设备密钥同样只属于这台设备（每个教务账号一把，与私信身份分开），不随备份与换机迁移。 -->
        <exclude domain="sharedpref" path="superxd_account.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_account.xml" />
        <!-- 本机诊断日志（应用专属外部目录的 logs，取不到时退回应用支持目录的 logs）与开发者设置 developer.json 只属于这台设备，不随备份与换机迁移。 -->
        <exclude domain="external" path="logs/" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="developer.json" />
    </device-transfer>
</data-extraction-rules>
