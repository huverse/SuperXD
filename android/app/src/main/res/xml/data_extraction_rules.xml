<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="superxd_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="file" path="toolbox/" />
        <exclude domain="file" path="backgroundDownloaderTaskRecords/" />
        <exclude domain="file" path="backgroundDownloaderResumeData/" />
        <exclude domain="file" path="backgroundDownloaderDatabase/" />
        <exclude domain="sharedpref" path="com.superxd.superxd_preferences.xml" />
        <exclude domain="sharedpref" path="com.superxd.superxd.alpha_preferences.xml" />
        <exclude domain="sharedpref" path="superxd_course_widget.xml" />
        <!-- 私信身份私钥只属于这台设备（Keystore 加密，换机无法解密）；私信库随身份一起排除，避免恢复出无法解密的会话。 -->
        <exclude domain="sharedpref" path="superxd_social.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_social.xml" />
        <exclude domain="database" path="social.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="superxd_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_credentials.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="file" path="toolbox/" />
        <exclude domain="file" path="backgroundDownloaderTaskRecords/" />
        <exclude domain="file" path="backgroundDownloaderResumeData/" />
        <exclude domain="file" path="backgroundDownloaderDatabase/" />
        <exclude domain="sharedpref" path="com.superxd.superxd_preferences.xml" />
        <exclude domain="sharedpref" path="com.superxd.superxd.alpha_preferences.xml" />
        <exclude domain="sharedpref" path="superxd_course_widget.xml" />
        <!-- 私信身份私钥只属于这台设备（Keystore 加密，换机无法解密）；私信库随身份一起排除，避免恢复出无法解密的会话。 -->
        <exclude domain="sharedpref" path="superxd_social.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:superxd_social.xml" />
        <exclude domain="database" path="social.db" />
    </device-transfer>
</data-extraction-rules>
